{
  "name": "holtmail",
  "private": true,
  "license": "MIT OR Apache-2.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "check": "bun run fmt:check && bun run lint && bun run typecheck && bun run test && bun run build",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint --type-aware",
    "typecheck": "tsc && tsc -p apps/web",
    "test": "bun test",
    "build": "bun run --filter @holtmail/web build",
    "knip": "knip",
    "dev:web": "bun run --filter @holtmail/web dev"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "knip": "^6.44.0",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "typescript": "7.0.2"
  },
  "packageManager": "bun@1.4.4"
}
