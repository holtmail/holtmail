[server]
hosts = 0.0.0.0:5232
ssl = True
certificate = /certs/server.crt
key = /certs/server-shared.key

[auth]
type = htpasswd
htpasswd_filename = /certs/radicale-users
htpasswd_encryption = plain
delay = 0

[rights]
type = owner_only

[storage]
filesystem_folder = /data/collections

[logging]
level = warning
