compatibility_level = 3.6
maillog_file = /dev/stdout
myhostname = mta.example.org
mydomain = example.org
myorigin = example.org
mydestination =
inet_interfaces = all
inet_protocols = ipv4
mynetworks = 0.0.0.0/0
smtpd_relay_restrictions = permit_mynetworks, reject
relayhost = [host.docker.internal]:42525
smtp_tls_security_level = verify
smtp_tls_CAfile = /etc/postfix/stack-ca.pem
smtp_tls_verify_cert_match = nexthop, localhost
smtp_tls_servername = localhost
message_size_limit = 20000000
maximal_queue_lifetime = 1h
bounce_queue_lifetime = 1h
minimal_backoff_time = 5s
maximal_backoff_time = 10s
queue_run_delay = 5s
smtp_tls_loglevel = 1
