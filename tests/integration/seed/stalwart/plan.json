{
  "using": ["urn:ietf:params:jmap:core", "urn:stalwart:jmap"],
  "methodCalls": [
    ["x:Domain/set", { "create": { "domain": { "name": "example.com" } } }, "domain"],
    [
      "x:Certificate/set",
      {
        "create": {
          "stack": {
            "certificate": { "@type": "File", "filePath": "/certs/server.crt" },
            "privateKey": { "@type": "File", "filePath": "/certs/server.key" }
          }
        }
      },
      "certificate"
    ],
    [
      "x:NetworkListener/set",
      {
        "create": {
          "imap": {
            "name": "imap",
            "bind": { "[::]:143": true },
            "protocol": "imap",
            "tlsImplicit": false
          },
          "imaps": {
            "name": "imaps",
            "bind": { "[::]:993": true },
            "protocol": "imap",
            "tlsImplicit": true
          },
          "https": {
            "name": "https",
            "bind": { "[::]:443": true },
            "protocol": "http",
            "tlsImplicit": true
          },
          "http": {
            "name": "http",
            "bind": { "[::]:8080": true },
            "protocol": "http",
            "useTls": false
          }
        }
      },
      "listeners"
    ],
    ["x:Imap/set", { "update": { "singleton": { "allowPlainTextAuth": true } } }, "imap"],
    [
      "x:Security/set",
      {
        "update": {
          "singleton": {
            "abuseBanRate": null,
            "authBanRate": null,
            "loiterBanRate": null,
            "scanBanRate": null
          }
        }
      },
      "security"
    ],
    [
      "x:Http/set",
      {
        "update": {
          "singleton": {
            "rateLimitAuthenticated": null,
            "rateLimitAnonymous": null
          }
        }
      },
      "http"
    ],
    ["x:SpamPyzor/set", { "update": { "singleton": { "enable": false } } }, "pyzor"],
    ["x:Application/get", { "properties": ["id", "enabled", "resourceUrl"] }, "applications"]
  ]
}
